# AWS API Gateway URL (CloudFormation Output → ApiEndpoint)
# 예: https://abc123xyz.execute-api.ap-northeast-2.amazonaws.com/prod
# - Vercel: Settings → Environment Variables → Redeploy 필수
# - 로컬: http://127.0.0.1:3000 (sam local start-api)
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-northeast-2.amazonaws.com/prod

# (선택) 카카오톡 공유하기 — 마지막 EndingSection 버튼용
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# [플랫폼]에 Vercel 도메인(https://xxx.vercel.app) 등록 후 Vercel Redeploy
# ※ 오시는 길 지도 버튼(네이버·티맵·카카오맵)은 API 키 없이 딥링크로 동작합니다.
VITE_KAKAO_JS_KEY=

# (선택) 오시는 길 지도 미리보기 — 네이버 지도 JS API
# 발급: https://console.ncloud.com → Application Services → Maps → Application 등록
# Web 서비스 URL: http://localhost , https://your-vercel-domain.vercel.app (포트·경로 제외)
# 인증 정보의 Client ID를 아래에 입력 후 dev 서버 재시작 / Vercel Redeploy
VITE_NAVER_MAP_CLIENT_ID=
