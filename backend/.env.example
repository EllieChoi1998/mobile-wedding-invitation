# Local SAM (참고용 — sam local에는 --parameter-overrides 사용)
# sam local start-api --parameter-overrides \
#   "AdminPassword=your-admin-password DeletePassword=your-delete-password FrontendOrigin=http://localhost:5173"
#
# GitHub Actions Secrets와 동일한 값을 쓰면 /admin·삭제 테스트가 편합니다.
ADMIN_PASSWORD=1234
DELETE_PASSWORD=5683
